{
  "name": "research-to-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env.local --import tsx worker/index.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "smoke": "node --env-file-if-exists=.env.local --import tsx scripts/smoke.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:py": "python -m unittest discover -s python -p \"test_*.py\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "agentmail": "^0.5.27",
    "bullmq": "^6.3.8",
    "ioredis": "^5.11.1",
    "next": "^16.3.5",
    "pg": "^8.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unpdf": "^1.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^3.2.0"
  }
}
