# BullMQ worker: runs ingestion, RAG, Claude synthesis, and python-pptx rendering.
# Deploy to Railway / Render / Fly as a long-running service (not Vercel).
FROM node:22-slim

WORKDIR /app
COPY python/requirements.txt ./python/requirements.txt

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pip \
  && pip3 install --no-cache-dir --break-system-packages -r python/requirements.txt \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY tsconfig.json ./
COPY src ./src
COPY worker ./worker
COPY python ./python
COPY db ./db
COPY scripts ./scripts

ENV NODE_ENV=production \
    PYTHON_BIN=python3

CMD ["node", "--import", "tsx", "worker/index.ts"]
