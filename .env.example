# Copy to .env.local and fill in. Never commit real values.

# Claude (synthesis + sub-query generation)
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5
CLAUDE_MODEL=

# Voyage AI (embeddings: voyage-3.5, 1024 dims; reranking: rerank-2.5)
VOYAGE_API_KEY=

# Paper search provider: openalex (default, no API key) or semanticscholar.
PAPER_SOURCE=openalex

# OpenAlex contact address. Not authentication - it opts you into the "polite pool"
# (10 req/s, 100k/day) instead of the slower anonymous pool. Strongly recommended.
OPENALEX_MAILTO=

# Only used when PAPER_SOURCE=semanticscholar (free key, manual approval queue:
# https://www.semanticscholar.org/product/api#api-key-form). The unauthenticated
# shared pool returns 429 to effectively every request, which is why OpenAlex is the default.
SEMANTIC_SCHOLAR_API_KEY=

# Postgres with pgvector
DATABASE_URL=postgres://deck:deck@localhost:5433/research_to_deck

# Redis for BullMQ
REDIS_URL=redis://localhost:6380

# Worker only: Python interpreter that has python-pptx installed
PYTHON_BIN=python

# --- AgentMail (optional: email delivery of finished decks) ---
# Leave AGENTMAIL_API_KEY empty to disable email entirely; everything else still works.
# Key from https://console.agentmail.to
AGENTMAIL_API_KEY=
# Sending/receiving domain. Defaults to agentmail.to; set a verified custom domain for branding.
AGENTMAIL_DOMAIN=
# Local part of the system inbox (decks@<domain>). Created idempotently on first send.
AGENTMAIL_INBOX_USERNAME=decks
# Svix signing secret for POST /api/webhooks/agentmail, from the webhook's detail page.
AGENTMAIL_WEBHOOK_SECRET=
# Public origin used for download/status links inside emails.
APP_BASE_URL=http://localhost:3000
