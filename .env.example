# Copy to .env.local and fill in. Never commit real values.

# Claude (synthesis + sub-query generation)
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5
CLAUDE_MODEL=
# Optional: route Claude through the Vercel AI Gateway instead of calling Anthropic
# directly, so usage bills to Vercel. When set it takes precedence over
# ANTHROPIC_API_KEY and the model id is prefixed with "anthropic/" automatically.
# Note: Vercel's free tier blocks Anthropic models - the account needs paid credits.
AI_GATEWAY_API_KEY=

# Voyage AI (embeddings: voyage-3.5, 1024 dims; reranking: rerank-2.5)
VOYAGE_API_KEY=

# Paper search provider: openalex (default, no API key) or semanticscholar.
PAPER_SOURCE=openalex

# OpenAlex contact address. Not authentication - it opts you into the "polite pool"
# (10 req/s, 100k/day) instead of the slower anonymous pool. Strongly recommended.
OPENALEX_MAILTO=

# Only used when PAPER_SOURCE=semanticscholar (free key, manual approval queue:
# https://www.semanticscholar.org/product/api#api-key-form). The unauthenticated
# shared pool returns 429 to effectively every request, which is why OpenAlex is the default.
SEMANTIC_SCHOLAR_API_KEY=

# --- Clerk (authentication) ---------------------------------------------------
# Provisioned by the Clerk integration on the Vercel Marketplace, which writes both
# keys into the project's environments; `vercel env pull .env.local` brings them down.
# Without them the app boots but every page throws: ClerkProvider wraps the whole tree.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where Clerk sends a visitor who needs to sign in. Keep in step with the routes under
# src/app/sign-in and src/app/sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Postgres with pgvector
DATABASE_URL=postgres://deck:deck@localhost:5433/research_to_deck

# Redis for BullMQ
REDIS_URL=redis://localhost:6380

# Worker only: Python interpreter that has python-pptx installed
PYTHON_BIN=python

# --- AgentMail (optional: email delivery of finished decks) ---
# Leave AGENTMAIL_API_KEY empty to disable email entirely; everything else still works.
# Key from https://console.agentmail.to
AGENTMAIL_API_KEY=
# Sending/receiving domain. Defaults to agentmail.to; set a verified custom domain for branding.
AGENTMAIL_DOMAIN=
# Local part of the system inbox (decks@<domain>). Created on first send if absent.
AGENTMAIL_INBOX_USERNAME=decks
# Reuse an existing inbox verbatim instead of creating one, e.g. decks@example.com.
# Required when the account is at its plan inbox limit; takes precedence over the two above.
AGENTMAIL_INBOX_ID=
# Svix signing secret for POST /api/webhooks/agentmail, from the webhook's detail page.
# Only needed for inbound email. Leave empty for outbound-only (the webhook route then 503s).
AGENTMAIL_WEBHOOK_SECRET=
# --- Stripe (optional: credits + custom deck branding) ---
# Leave STRIPE_SECRET_KEY empty to switch billing off: runs are then free and unlimited.
# Set it and every account gets 1 free credit, then buys packs (see CREDIT_PACKS in
# src/lib/billing.ts). Prices are inline, so the Stripe account needs no products.
# App only - the worker never reads these.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint for POST /api/webhooks/stripe, events
# checkout.session.completed and checkout.session.async_payment_succeeded.
STRIPE_WEBHOOK_SECRET=

# Public origin used for download/status links inside emails.
APP_BASE_URL=http://localhost:3000
